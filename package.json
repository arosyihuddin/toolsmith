{
  "name": "toolsmith",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "build": "NODE_ENV=production bun build --target=bun --packages=external --outfile=dist/index.js src/index.ts && mkdir -p dist/migrations && cp -a src/control-plane/db/migrations/. dist/migrations/",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  }
}
