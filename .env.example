# Runtime
NODE_ENV=production
LOG_LEVEL=info

# MCP transport
# stdio | http | both
MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=48765
MCP_HTTP_PATH=/mcp

# Required for Toolsmith Console/internal HTTP endpoints. `make setup` generates a random 256-bit token if empty.
# Configure the same value in the matching Toolsmith Console instance. Keep it secret.
TOOLSMITH_API_TOKEN=

# OAuth 2.0 for remote MCP clients. `make setup` prompts for username/password.
# Set MCP_PUBLIC_URL to the public HTTPS origin only, without /mcp or a trailing path.
MCP_PUBLIC_URL=https://mcp.example.com
TOOLSMITH_OAUTH_USERNAME=admin
TOOLSMITH_OAUTH_PASSWORD=

# Required to encrypt the per-instance sudo password saved from Toolsmith Console.
# `make setup` generates a random 256-bit key if empty; keep it stable across restarts.
TOOLSMITH_SUDO_ENCRYPTION_KEY=
