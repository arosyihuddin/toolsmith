[Unit]
Description=Toolsmith Browser Relay
After=network.target

[Service]
Type=simple
User=pstar7
Group=pstar7
Environment=HOME=/home/pstar7
Environment=PATH=/home/pstar7/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pstar7/.bun/bin/omp browser-relay
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
