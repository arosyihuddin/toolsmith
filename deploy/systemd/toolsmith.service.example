[Unit]
Description=Toolsmith MCP Server
After=network.target

[Service]
Type=simple
User=pstar7
Group=pstar7
WorkingDirectory=/opt/toolsmith
EnvironmentFile=/opt/toolsmith/.env
Environment=HOME=/home/pstar7
Environment=NODE_ENV=production
ExecStart=/opt/toolsmith/bin/bun run dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
