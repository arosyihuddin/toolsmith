{
  "name": "toolsmith",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production bun run dist/index.js",
    "dev": "bun run build:ui && NODE_ENV=development bun --watch src/index.ts",
    "build": "bun run build:ui && NODE_ENV=production bun build --target=bun --packages=external --outfile=dist/index.js src/index.ts && rm -rf dist/migrations && mkdir -p dist/migrations && cp -a src/control-plane/db/migrations/. dist/migrations/",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json",
    "test": "NODE_ENV=test bun test",
    "cli": "bun run src/cli.ts",
    "build:ui": "bun x vite build",
    "check:ui": "bun x svelte-check --workspace . --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
